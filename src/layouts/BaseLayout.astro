---
/**
 * Document shell of the single page:
 * metadata/SEO → Header → main content (sections) → Footer.
 */
import BaseHead from "@/components/layout/BaseHead.astro";
import Header from "@/components/layout/Header.astro";
import IntroLoader from "@/components/layout/IntroLoader.astro";
import Footer from "@/components/layout/Footer.astro";
import { toLang } from "@/i18n";

export interface Props {
  image?: string;
  noIndex?: boolean;
}

const { image, noIndex } = Astro.props;
const lang = toLang(Astro.currentLocale);
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead image={image} noIndex={noIndex} />
    <!--
      Language (see src/i18n/index.ts for the overall approach).

      The page arrives in the language of its URL, with the text of both
      languages in it; CSS shows the one matching <html lang>. This script:
        - applies a saved preference before the first paint, so the page
          never flashes in the other language;
        - switches in place when "SR / EN" is clicked, without a page load,
          and remembers the choice in localStorage; the text on screen
          fades out, changes, and fades back in with a slight rise;
        - keeps the address ("/" or "/en/"), the title, the description
          and translated attributes (alt text, labels) in step.
      First inline script on purpose: the intro below shows translated text.
    -->
    <script is:inline>
      (function () {
        var STORAGE_KEY = "lang";
        var LANGS = ["sr", "en"];
        var root = document.documentElement;

        function read() {
          try {
            var saved = localStorage.getItem(STORAGE_KEY);
            return LANGS.indexOf(saved) === -1 ? null : saved;
          } catch (error) {
            return null;
          }
        }

        var pageLang = LANGS.indexOf(root.lang) === -1 ? "sr" : root.lang;
        var lang = read() || pageLang;
        root.lang = lang;

        // Everything that is not plain visible text: attributes, the
        // document title, the switcher's state and the address bar.
        function sync() {
          var translated = document.querySelectorAll("[data-i18n]");
          for (var i = 0; i < translated.length; i++) {
            var el = translated[i];
            var name = el.getAttribute("data-i18n");
            var value = el.getAttribute("data-" + lang + "-" + name);
            if (value !== null) el.setAttribute(name, value);
          }

          var texts = document.querySelectorAll("[data-i18n-text]");
          for (var j = 0; j < texts.length; j++) {
            var text = texts[j].getAttribute("data-" + lang + "-text");
            if (text !== null) texts[j].textContent = text;
          }

          var options = document.querySelectorAll("[data-lang-switch]");
          for (var k = 0; k < options.length; k++) {
            var option = options[k];
            var active = option.getAttribute("data-lang-switch") === lang;
            if (active) option.setAttribute("aria-current", "true");
            else option.removeAttribute("aria-current");

            var path = new URL(option.href).pathname;
            if (active && path !== location.pathname) {
              history.replaceState(
                history.state,
                "",
                path + location.search + location.hash,
              );
            }
          }
        }

        function applyLang(next) {
          // Text length differs between languages, so sections change
          // height. Keep whichever section is being read where it is.
          var anchor = null;
          var before = 0;
          var blocks = document.querySelectorAll("main > section, footer");
          for (var i = 0; i < blocks.length; i++) {
            var rect = blocks[i].getBoundingClientRect();
            if (rect.bottom > window.innerHeight * 0.3) {
              anchor = blocks[i];
              before = rect.top;
              break;
            }
          }

          lang = next;
          root.lang = lang;
          try {
            localStorage.setItem(STORAGE_KEY, lang);
          } catch (error) {
            // Storage unavailable: the switch still works for this visit.
          }
          sync();

          if (anchor && window.scrollY > 0) {
            var shift = anchor.getBoundingClientRect().top - before;
            if (shift) window.scrollBy({ top: shift, behavior: "instant" });
          }
        }

        /*
         * The transition between languages.
         *
         * Translated text sits in [data-lang] elements, one per language
         * (ui/Localized.astro), so no component needs to know about this:
         * the elements of the language on screen fade out, the language
         * changes while nothing is showing, and the new ones fade in.
         * Opacity is animated on the text itself. The few pixels of
         * movement are animated on its parent, because inline text cannot
         * be moved with a transform, and only where that parent is plain
         * text: a button with its own background stays put.
         *
         * Only what is on screen is animated, with the Web Animations API,
         * so nothing is left behind in the styles and the reveal and hover
         * animations are untouched.
         */
        var OUT_MS = 130;
        var IN_MS = 190;
        var RISE_PX = 5;
        var target = lang;
        var switching = false;

        function onScreenText(code) {
          var found = [];
          var nodes = document.querySelectorAll('[data-lang="' + code + '"]');
          var limit = window.innerHeight + 100;
          for (var i = 0; i < nodes.length; i++) {
            var rect = nodes[i].getBoundingClientRect();
            if (rect.width && rect.bottom > -100 && rect.top < limit) {
              found.push(nodes[i]);
            }
          }
          return found;
        }

        /** The parents that may move: plain text blocks, each once. */
        function movable(nodes) {
          var parents = [];
          for (var i = 0; i < nodes.length; i++) {
            var parent = nodes[i].parentElement;
            if (!parent || parents.indexOf(parent) !== -1) continue;
            var background = getComputedStyle(parent).backgroundColor;
            var plain = background === "transparent" || /, 0\)$/.test(background);
            if (plain) parents.push(parent);
          }
          return parents;
        }

        function animateAll(nodes, keyframes, options) {
          var running = [];
          for (var i = 0; i < nodes.length; i++) {
            running.push(nodes[i].animate(keyframes, options));
          }
          return running;
        }

        function cancelAll(animations) {
          for (var i = 0; i < animations.length; i++) animations[i].cancel();
        }

        function setLang(next) {
          if (LANGS.indexOf(next) === -1) return;
          // Clicks during a transition only change where it ends up.
          target = next;
          if (!switching) run();
        }

        function run() {
          if (target === lang) return;

          var reduced =
            window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (reduced || !document.documentElement.animate) {
            applyLang(target);
            return;
          }

          switching = true;
          var leaving = onScreenText(lang);
          var out = { duration: OUT_MS, easing: "ease-in", fill: "forwards" };
          var fading = animateAll(leaving, [{ opacity: 1 }, { opacity: 0 }], out).concat(
            animateAll(
              movable(leaving),
              [{ translate: "0 0" }, { translate: "0 -" + RISE_PX + "px" }],
              out,
            ),
          );

          setTimeout(function () {
            // Still wanted? A second click may have changed it back.
            if (target !== lang) applyLang(target);
            cancelAll(fading);

            var arriving = onScreenText(lang);
            var into = { duration: IN_MS, easing: "ease-out" };
            animateAll(arriving, [{ opacity: 0 }, {}], into);
            animateAll(
              movable(arriving),
              [{ translate: "0 " + RISE_PX + "px" }, {}],
              into,
            );

            setTimeout(function () {
              switching = false;
              // Clicked again meanwhile: go there now.
              run();
            }, IN_MS);
          }, OUT_MS);
        }

        document.addEventListener("click", function (event) {
          var option =
            event.target.closest && event.target.closest("[data-lang-switch]");
          if (!option) return;
          // Leave "open in new tab" and similar to the browser.
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
            return;
          }
          event.preventDefault();
          setLang(option.getAttribute("data-lang-switch"));
        });

        if (lang !== pageLang) {
          document.addEventListener("DOMContentLoaded", sync);
        }
      })();
    </script>
    <!--
      Intro (markup and styles in components/layout/IntroLoader.astro).
      Shown once per browser session. Inline and in the head so the class
      is set before the first paint and the page never flashes first.

      The intro's animation is CSS, but it stays paused until this script
      adds `intro-play`: a CSS animation's clock starts when the element is
      styled, which can be well before the browser manages to paint it, and
      then the first words would already be on screen in the first frame.
      The script starts the clock once the fonts are in and a frame has
      actually been painted, lifts the panel a fixed time later, and cleans
      up afterwards.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var SEEN_KEY = "intro-seen";
        // When the panel lifts, counted from the start of the animation.
        // Keep in sync with the timeline in IntroLoader.astro.
        var INTRO_PLAY_MS = 2300;
        // Longest wait for fonts before starting anyway.
        var FONT_WAIT_MS = 1000;
        // Never keep visitors waiting longer than this, whatever happens.
        var INTRO_MAX_MS = 6000;
        // A little longer than the exit transition in IntroLoader.astro.
        var EXIT_MS = 600;

        try {
          if (sessionStorage.getItem(SEEN_KEY)) return;
          sessionStorage.setItem(SEEN_KEY, "1");
        } catch (error) {
          // Storage unavailable: show the intro, it just cannot be remembered.
        }

        var playing = false;
        var exiting = false;
        root.classList.add("intro-active");

        // Keep the page still underneath without touching its layout (no
        // overflow lock, so no scrollbar or content shift when it ends).
        var scrollKeys = [" ", "PageDown", "PageUp", "End", "Home", "ArrowDown", "ArrowUp"];
        function block(event) {
          if (event.type === "keydown" && scrollKeys.indexOf(event.key) === -1) return;
          event.preventDefault();
        }
        var blocked = ["wheel", "touchmove", "keydown"];
        blocked.forEach(function (type) {
          window.addEventListener(type, block, { passive: false });
        });

        function finish() {
          blocked.forEach(function (type) {
            window.removeEventListener(type, block, { passive: false });
          });
          var intro = document.getElementById("intro");
          if (intro) intro.remove();
          root.classList.remove("intro-active", "intro-play", "intro-exit");
        }

        function exit() {
          if (exiting) return;
          exiting = true;
          root.classList.add("intro-exit");
          document.dispatchEvent(new Event("intro:exit"));
          setTimeout(finish, EXIT_MS);
        }

        // Start the animation on a painted frame, then lift after it has
        // played in full.
        function play() {
          if (playing) return;
          playing = true;
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              root.classList.add("intro-play");
              setTimeout(exit, INTRO_PLAY_MS);
            });
          });
        }

        document.addEventListener("DOMContentLoaded", function () {
          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(play);
          }
          setTimeout(play, FONT_WAIT_MS);
        });
        setTimeout(exit, INTRO_MAX_MS);
      })();
    </script>

    <!--
      Reveal on scroll (styles in global.css). Inline and in the head so
      `reveal-ready` is set before the first paint and marked elements never
      flash. The class and the observer come from the same script, so
      content is only ever hidden when something is in place to show it.

      While the intro is showing, revealing waits until it starts to lift,
      so the hero's entrance plays as the page comes into view.
    -->
    <script is:inline>
      (function () {
        if (!("IntersectionObserver" in window)) return;
        var root = document.documentElement;
        root.classList.add("reveal-ready");

        // One observer per threshold, created on demand.
        var observers = {};
        function observe(el, threshold) {
          if (!observers[threshold]) {
            observers[threshold] = new IntersectionObserver(
              function (entries, observer) {
                entries.forEach(function (entry) {
                  if (!entry.isIntersecting) return;
                  var target = entry.target;
                  var items = target.hasAttribute("data-reveal-group")
                    ? target.querySelectorAll("[data-reveal]")
                    : [target];
                  for (var i = 0; i < items.length; i++) {
                    items[i].setAttribute("data-revealed", "");
                  }
                  observer.unobserve(target);
                });
              },
              { rootMargin: "0px 0px -6% 0px", threshold: threshold },
            );
          }
          observers[threshold].observe(el);
        }

        function start() {
          // Elements reveal on their own as they enter the viewport...
          document.querySelectorAll("[data-reveal]").forEach(function (el) {
            if (!el.closest("[data-reveal-group]")) observe(el, 0.01);
          });
          // ...except inside a group, which reveals all of its elements
          // together (staggered by their delays) once the given share of
          // the group is on screen, e.g. data-reveal-group="0.3".
          document.querySelectorAll("[data-reveal-group]").forEach(function (group) {
            var share = parseFloat(group.getAttribute("data-reveal-group"));
            observe(group, share > 0 && share <= 1 ? share : 0.01);
          });
        }

        document.addEventListener("DOMContentLoaded", function () {
          var introShowing =
            root.classList.contains("intro-active") &&
            !root.classList.contains("intro-exit");
          if (introShowing) {
            document.addEventListener("intro:exit", start, { once: true });
          } else {
            start();
          }
        });
      })();
    </script>
  </head>
  <body>
    <IntroLoader />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
