---
/**
 * Large typographic hero title: first name outlined, last name solid.
 *
 * The font size comes from `--hero-title-size`, set by the hero wrapper in
 * HomeSection.astro.
 */
import { siteConfig } from "@/config/site";

export interface Props {
  id?: string;
}

const { id } = Astro.props;
const [firstName, ...rest] = siteConfig.name.split(" ");
const lastName = rest.join(" ");
---

<h1 id={id} class="hero-title">
  <span class="hero-title-outline">{firstName}</span>
  <span>{lastName}</span>
</h1>

<style>
  .hero-title {
    display: flex;
    justify-content: center;
    gap: 0.16em;
    font-size: var(--hero-title-size);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-foreground);
  }

  /*
   * Filled with the page colour and painted over the stroke, so only the
   * outer half of the stroke shows. This hides the overlapping contours a
   * variable font would otherwise reveal inside the letters.
   */
  .hero-title-outline {
    color: var(--color-background);
    -webkit-text-stroke: max(2px, 0.03em) var(--color-foreground);
    paint-order: stroke fill;
  }

  /* Below this width one line would get too small: stack the two words. */
  @media (width < 36rem) {
    .hero-title {
      flex-direction: column;
      align-items: center;
      gap: 0;
    }

    /*
     * The negative letter-spacing is also applied after the last letter,
     * which makes each line's box end short of its letters. Give that back
     * so the centred lines are centred on what is actually visible.
     */
    .hero-title > span {
      padding-right: 0.035em;
    }
  }
</style>
