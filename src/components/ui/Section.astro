---
/**
 * Page section wrapper. Provides the anchor target used by the navigation
 * and the shared page container.
 *
 * The scroll margin keeps the section clear of the sticky header when it is
 * reached through an anchor link. A section that sets `--section-pt` and
 * uses it as its top padding (`pt-(--section-pt)`) has that padding taken
 * off the margin, so the link lands just above the section's content
 * instead of above its empty top space.
 */
import type { SectionId } from "@/config/site";

export interface Props {
  /** Anchor id — navigation links scroll to `#id`. */
  id: SectionId;
  /** Id of the heading inside the section, used as its accessible name. */
  labelledBy?: string;
  /** Wrap the content in the page container. Disable for full-width sections. */
  contained?: boolean;
  class?: string;
}

const {
  id,
  labelledBy = `${id}-heading`,
  contained = true,
  class: className,
} = Astro.props;
---

<section
  id={id}
  aria-labelledby={labelledBy}
  class:list={[
    "scroll-mt-[calc(var(--spacing-scroll-offset)-var(--section-pt,0px))]",
    className,
  ]}
>
  <div class:list={[contained && "container-page"]}>
    <slot />
  </div>
</section>
