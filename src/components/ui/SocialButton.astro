---
/**
 * Small outlined pill linking to a social profile: logo on the left, the
 * platform name next to it. Opens in a new tab.
 */
import { Image } from "astro:assets";
import type { SocialLink } from "@/types/socialLink";

export interface Props {
  link: SocialLink;
  class?: string;
}

const { link, class: className } = Astro.props;
---

<a
  href={link.url}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "inline-flex min-h-12 items-center gap-2.5 rounded-full border border-border bg-surface px-5 text-[0.9375rem] font-medium whitespace-nowrap transition-colors hover:border-foreground/40",
    className,
  ]}
>
  <Image
    src={link.icon}
    alt=""
    width={20}
    height={20}
    densities={[1, 2, 3]}
    class="size-5"
  />
  {link.label}
  <span class="sr-only">(otvara se u novoj kartici)</span>
</a>
