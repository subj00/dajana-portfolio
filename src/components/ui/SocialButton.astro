---
/**
 * Small outlined pill linking to a social profile: logo on the left, the
 * platform name next to it. Opens in a new tab.
 *
 * On hover the pill lifts slightly and inverts to dark; the logo is a black
 * PNG, so it is inverted along with it.
 */
import { Image } from "astro:assets";
import type { SocialLink } from "@/types/socialLink";

export interface Props {
  link: SocialLink;
  class?: string;
}

const { link, class: className } = Astro.props;
---

<a
  href={link.url}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "group inline-flex min-h-12 items-center gap-2.5 rounded-full border border-border bg-surface px-5 text-[0.9375rem] font-medium whitespace-nowrap transition duration-300 ease-out-soft hover:-translate-y-0.5 hover:border-foreground hover:bg-foreground hover:text-background active:translate-y-0 motion-reduce:transition-colors motion-reduce:hover:translate-y-0",
    className,
  ]}
>
  <Image
    src={link.icon}
    alt=""
    width={20}
    height={20}
    densities={[1, 2, 3]}
    class="size-5 transition duration-300 ease-out-soft group-hover:invert"
  />
  {link.label}
  <span class="sr-only">(otvara se u novoj kartici)</span>
</a>
