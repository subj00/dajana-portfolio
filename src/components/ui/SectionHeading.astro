---
/**
 * Section heading: the same heavy, tight, uppercase treatment as the hero
 * name, at section scale.
 */
export interface Props {
  id?: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<h2
  id={id}
  class:list={[
    "text-[clamp(2.5rem,5.5vw,4.5rem)] leading-none font-extrabold tracking-[-0.025em] uppercase",
    className,
  ]}
>
  <slot />
</h2>
