---
/**
 * Portfolio card: image, title and a short description.
 *
 * The image is cropped to one shared frame so all cards match whatever the
 * source proportions. On hover the card lifts slightly, its shadow deepens
 * and the image eases in a little inside the frame.
 */
import { Image } from "astro:assets";
import type { Project } from "@/types/project";

export interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-md border border-border/70 bg-surface shadow-card transition duration-500 ease-out-soft hover:-translate-y-1 hover:shadow-card-hover motion-reduce:transition-shadow motion-reduce:hover:translate-y-0"
>
  <div class="aspect-3/2 overflow-hidden">
    <Image
      src={project.image}
      alt={project.imageAlt}
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 56rem) 45vw, 92vw"
      class="size-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
      style={{ objectPosition: project.imagePosition ?? "50% 50%" }}
    />
  </div>

  <div class="p-6 sm:p-7 lg:p-8">
    <h3
      class="text-[clamp(1.25rem,1.7vw,1.5rem)] leading-snug font-semibold tracking-[0.01em]"
    >
      {project.title}
    </h3>
    <p class="mt-3 text-[0.9375rem] leading-[1.65] text-muted">
      {project.description}
    </p>
  </div>
</article>
