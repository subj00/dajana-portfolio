---
/**
 * Document metadata and SEO tags, in the page's language.
 *
 * Translated values also carry both versions as data attributes so the
 * language script (BaseLayout.astro) can keep the title, description and
 * canonical URL in step when the language is switched without a page load.
 */
import { siteConfig } from "@/config/site";
import {
  defaultLang,
  langPath,
  languages,
  localizedAttr,
  ogLocales,
  toLang,
  tr,
  type Localized,
} from "@/i18n";
import "@/styles/global.css";

export interface Props {
  /** Absolute or root-relative path to a social preview image. */
  image?: string;
  noIndex?: boolean;
}

const { image = siteConfig.seo.defaultOgImage, noIndex = false } = Astro.props;

const lang = toLang(Astro.currentLocale);
const title = tr((d) => d.meta.title);
const description = tr((d) => d.meta.description);

const absolute = (path: string) => new URL(path, Astro.site).toString();
/** Absolute URL of this page in each language. */
const urls: Localized = {
  sr: absolute(langPath("sr")),
  en: absolute(langPath("en")),
};
const imageUrl = image ? absolute(image) : undefined;
const faviconUrl = `${langPath(defaultLang)}favicon.svg`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/svg+xml" href={faviconUrl} />

<title data-i18n-text data-sr-text={title.sr} data-en-text={title.en}
  >{title[lang]}</title
>
<meta name="description" {...localizedAttr("content", description, lang)} />
<link rel="canonical" {...localizedAttr("href", urls, lang)} />
{
  languages.map((code) => (
    <link rel="alternate" hreflang={code} href={urls[code]} />
  ))
}
<link rel="alternate" hreflang="x-default" href={urls[defaultLang]} />
{noIndex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={title[defaultLang]} />
<meta property="og:locale" {...localizedAttr("content", ogLocales, lang)} />
<meta property="og:title" {...localizedAttr("content", title, lang)} />
<meta
  property="og:description"
  {...localizedAttr("content", description, lang)}
/>
<meta property="og:url" {...localizedAttr("content", urls, lang)} />
{imageUrl && <meta property="og:image" content={imageUrl} />}

<!-- Twitter -->
<meta name="twitter:card" content={siteConfig.seo.twitterCard} />
<meta name="twitter:title" {...localizedAttr("content", title, lang)} />
<meta
  name="twitter:description"
  {...localizedAttr("content", description, lang)}
/>
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
