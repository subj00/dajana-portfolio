---
/**
 * Site header: a full-width, sticky bar with the in-page navigation.
 * Links are native anchors; smooth scrolling is handled in global.css and
 * the scroll offset for the sticky bar in ui/Section.astro.
 *
 * The language switcher is the last item of the same row. Below `md` it
 * is spaced like the links; from `md` up it sits at the far right, outside
 * the flow of the links so they stay centred (on tablets the links make a
 * little room for it on the right).
 *
 * On phones the row is tight: the links use a small gap, a long label
 * wraps onto two lines. Under 23.4375rem (375px) the switcher stacks "SR"
 * over "EN", and under 22.5rem (360px) the type is also half a pixel smaller.
 */
import LanguageSwitcher from "@/components/layout/LanguageSwitcher.astro";
import Localized from "@/components/ui/Localized.astro";
import { sectionIds, siteConfig } from "@/config/site";
import { localizedAttr, toLang, tr } from "@/i18n";

const pageLang = toLang(Astro.currentLocale);
---

<!--
  Edge-to-edge bar flush with the top of the viewport, in the page
  background colour. Only the navigation content is inset.
-->
<header class="sticky top-0 z-50 w-full bg-background">
  <nav
    {...localizedAttr("aria-label", tr((d) => d.nav.label), pageLang)}
    class="flex h-header items-center px-2 min-[22.5rem]:px-2.5 sm:px-[8%] md:pr-[calc(8%+3rem)] lg:pr-[8%]"
  >
    <!--
      Below `sm` the links are capped in width, so a long label wraps onto
      two lines instead of overflowing.
    -->
    <ul
      class="flex w-full items-center justify-between gap-x-1.5 sm:justify-evenly sm:gap-x-6"
    >
      {
        siteConfig.navigation.map((key) => (
          <li class="max-sm:max-w-24">
            <a
              href={`#${sectionIds[key]}`}
              class="nav-link relative block rounded-sm py-2 text-center text-[0.65625rem] leading-snug font-semibold tracking-[0.02em] text-foreground uppercase min-[22.5rem]:text-[0.6875rem] min-[22.5rem]:tracking-[0.03em] sm:text-xs sm:tracking-[0.1em] sm:whitespace-nowrap lg:text-[0.8125rem] lg:tracking-[0.12em]"
            >
              <Localized text={tr((d) => d.nav[key])} />
            </a>
          </li>
        ))
      }
      <li class="shrink-0 md:absolute md:inset-y-0 md:right-[4%] md:flex md:items-center">
        <LanguageSwitcher />
      </li>
    </ul>
  </nav>
</header>

<style>
  /*
   * Hover / keyboard focus: a hairline draws in under the label from the
   * left and retracts to the right when the pointer leaves.
   */
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    /* Stop short of the letter-spacing that trails the last letter. */
    right: 0.1em;
    bottom: 0.25rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 350ms var(--ease-out-soft);
  }

  @media (hover: hover) {
    .nav-link:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  .nav-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }
</style>
