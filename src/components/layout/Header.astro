---
/**
 * Site header: a full-width, sticky bar with the in-page navigation.
 * Links are native anchors; smooth scrolling is handled in global.css and
 * the scroll offset for the sticky bar in ui/Section.astro.
 */
import { siteConfig } from "@/config/site";
---

<!--
  Edge-to-edge bar flush with the top of the viewport, in the page
  background colour. Only the navigation content is inset.
-->
<header class="sticky top-0 z-50 w-full bg-background">
  <nav
    aria-label="Glavna navigacija"
    class="flex h-header items-center px-3 sm:px-[8%]"
  >
    <!--
      Below `sm` the links are capped in width, so a long label wraps onto
      two lines instead of overflowing.
    -->
    <ul
      class="flex w-full items-center justify-between gap-x-2 sm:justify-evenly sm:gap-x-6"
    >
      {
        siteConfig.navigation.map((item) => (
          <li class="max-sm:max-w-24">
            <a
              href={item.href}
              class="nav-link relative block rounded-sm py-2 text-center text-[0.6875rem] leading-snug font-semibold tracking-[0.04em] text-foreground uppercase sm:text-xs sm:tracking-[0.1em] sm:whitespace-nowrap lg:text-[0.8125rem] lg:tracking-[0.12em]"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  /*
   * Hover / keyboard focus: a hairline draws in under the label from the
   * left and retracts to the right when the pointer leaves.
   */
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    /* Stop short of the letter-spacing that trails the last letter. */
    right: 0.1em;
    bottom: 0.25rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 350ms var(--ease-out-soft);
  }

  @media (hover: hover) {
    .nav-link:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  .nav-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }
</style>
