---
/**
 * One row of the contact list: icon, small label, value and an arrow. The
 * whole row is the link.
 *
 * Hover / keyboard focus: the icon badge inverts to dark (as the hero's
 * social buttons do), the text eases a few pixels to the right, and the
 * arrow moves up and out.
 */
import { Image } from "astro:assets";
import ArrowIcon from "@/components/ui/ArrowIcon.astro";
import type { ContactItem } from "@/types/contact";

export interface Props {
  item: ContactItem;
}

const { item } = Astro.props;
const externalAttrs = item.external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};

// An email address that does not fit on one line should break before the
// "@", not in the middle of a word.
const [emailLocal, emailDomain] = item.href.startsWith("mailto:")
  ? item.value.split("@")
  : [];
---

<a
  href={item.href}
  {...externalAttrs}
  class="group flex items-center gap-4 py-5 sm:gap-5 lg:py-6"
>
  <span
    class="grid size-12 shrink-0 place-items-center rounded-full border border-border bg-surface transition-colors duration-300 ease-out-soft group-hover:border-foreground group-hover:bg-foreground group-focus-visible:border-foreground group-focus-visible:bg-foreground"
  >
    <Image
      src={item.icon}
      alt=""
      width={20}
      height={20}
      densities={[1, 2, 3]}
      class="size-5 object-contain transition duration-300 ease-out-soft group-hover:invert group-focus-visible:invert"
    />
  </span>
  <span
    class="min-w-0 flex-1 transition-transform duration-300 ease-out-soft group-hover:translate-x-1 group-focus-visible:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
  >
    <span
      class="block text-[0.6875rem] font-semibold tracking-[0.14em] text-muted uppercase"
    >
      {item.label}
    </span>
    <span
      class="mt-1 block text-[clamp(1.0625rem,1.5vw,1.375rem)] leading-snug font-medium tracking-[-0.01em] wrap-anywhere"
    >
      {
        emailDomain ? (
          <>{emailLocal}<wbr />@{emailDomain}</>
        ) : (
          item.value
        )
      }
    </span>
  </span>
  {item.external && <span class="sr-only">(otvara se u novoj kartici)</span>}
  <ArrowIcon
    class="size-4 shrink-0 text-muted transition duration-300 ease-out-soft group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-foreground group-focus-visible:translate-x-1 group-focus-visible:-translate-y-1 group-focus-visible:text-foreground motion-reduce:transition-colors motion-reduce:group-hover:translate-0"
  />
</a>
