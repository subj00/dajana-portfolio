---
/**
 * Experience section. Structural placeholder only — design comes later.
 */
import Section from "@/components/ui/Section.astro";
import { sectionIds } from "@/config/site";
---

<!--
  min-h-svh / py-16 are placeholder spacing until the section is designed.
  svh, not dvh: a height that changes as the mobile browser bar shows and
  hides moves the sections below it while an anchor scroll is in progress.
-->
<Section id={sectionIds.experience} class="min-h-svh py-16">
  <h2 id={`${sectionIds.experience}-heading`}>Karijera i obrazovanje</h2>
  <p>Placeholder — this section will be designed separately.</p>
</Section>
