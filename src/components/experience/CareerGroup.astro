---
/**
 * One group of the career section: its title and a divided list of entries
 * (title and subtitle on the left, period on the right). Subtitle and
 * period are optional, so the same rows serve plain lists such as the
 * languages; with `columns` the rows flow into two columns once the list
 * is wide enough (used for the skills).
 *
 * From `md` up the group title sits in a column to the left of the list.
 * From `lg` up that column is the same width as the Contact section's photo
 * column, so the lists of both sections start on the same line. Below `md`
 * there is no room for two columns and the title sits above the list.
 *
 * Reveal: the title leads, then the list's top rule fades in and the rows
 * rise in with a small stagger. Beside the list the title slides in from
 * the left; stacked above it (mobile) it rises like everything else, so
 * nothing moves sideways on narrow screens.
 */
import Localized from "@/components/ui/Localized.astro";
import { field, zip, type Localized as LocalizedValue } from "@/i18n";
interface CareerEntry {
  title: string;
  subtitle?: string;
  period?: string;
}

interface CareerGroup {
  title: string;
  entries: CareerEntry[];
}

export interface Props {
  /** The group in every language (see ExperienceSection.astro). */
  group: LocalizedValue<CareerGroup>;
  /** Lay the rows out in two columns where the list is wide enough. */
  columns?: boolean;
}

const { group, columns = false } = Astro.props;
const entries = zip(field(group, "entries"));

/** An optional field counts only if it is filled in in every language. */
const optional = (
  entry: LocalizedValue<CareerEntry>,
  key: "subtitle" | "period",
): LocalizedValue<string> | undefined => {
  const sr = entry.sr[key];
  const en = entry.en[key];
  return sr && en ? { sr, en } : undefined;
};
---

<section
  class="grid gap-y-4 md:grid-cols-[minmax(0,15rem)_minmax(0,1fr)] md:gap-x-10 lg:grid-cols-[min(42%,30rem)_minmax(0,1fr)] lg:gap-x-[clamp(2.5rem,6vw,6rem)]"
>
  <!-- The top padding lines the title up with the first row's text. -->
  <h3
    class="text-[clamp(1.125rem,1.9vw,1.625rem)] leading-snug font-semibold tracking-[0.14em] text-balance uppercase md:pt-5 md:[--reveal-distance:0px] md:[--reveal-x:-0.875rem] lg:pt-5.5"
    data-reveal
    style="--reveal-duration: 700ms"
  >
    <Localized text={field(group, "title")} />
  </h3>

  <!--
    The list itself only fades (for its top rule); the rows do the moving.
    Custom properties inherit, so each row sets its own distance back to
    the default instead of picking up the list's 0.
  -->
  <!-- The wrapper is the size container the two-column layout responds to. -->
  <div class="@container">
    <ul
      class:list={[
        "border-t border-background/15",
        columns && "grid @xl:grid-cols-2",
      ]}
      data-reveal
      style="--reveal-distance: 0px; --reveal-delay: 100ms; --reveal-duration: 600ms"
    >
      {
        entries.map((entry, index) => {
          const subtitle = optional(entry, "subtitle");
          const period = optional(entry, "period");
          return (
            <li
              class:list={[
                "grid gap-x-8 gap-y-2 border-b border-background/15 py-5 tablet:grid-cols-[minmax(0,1fr)_auto] tablet:items-baseline lg:py-6",
                // In two columns the space between them is padding, not a
                // gap, so the dividing lines run unbroken across the list.
                columns && "@xl:odd:pr-10",
              ]}
              data-reveal
              style={`--reveal-distance: var(--reveal-distance-base); --reveal-delay: ${120 + Math.min(index, 5) * 80}ms; --reveal-duration: 700ms`}
            >
              <div>
                <p class="text-[clamp(1.0625rem,1.5vw,1.375rem)] leading-snug font-semibold tracking-[-0.01em]">
                  <Localized text={field(entry, "title")} />
                </p>
                {subtitle && (
                  <p class="mt-1 text-[0.9375rem] leading-normal text-background/60">
                    <Localized text={subtitle} />
                  </p>
                )}
              </div>
              {period && (
                <p class="text-[0.9375rem] font-medium whitespace-nowrap text-background/70 tabular-nums tablet:text-right">
                  <Localized text={period} />
                </p>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
